      }
    },
    {
      "name": "test_os_posture_intercept",
      "configType": "@intercept.v1",
      "data": {
        "protocols": ["tcp"],
        "addresses": ["100.64.0.21/32"],
        "portRanges": [{ "low": 23001, "high": 23001 }]
      }
    },
    {
      "name": "test_mac_posture_host_cfg",
      "configType": "@host.v1",
      "data": {
        "protocol": "tcp",
        "address": "127.0.0.1",
        "port": 23182
