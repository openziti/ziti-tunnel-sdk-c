    },
    {
      "name": "test_proc_posture_intercept",
      "configType": "@intercept.v1",
      "data": {
        "protocols": ["tcp"],
        "addresses": ["100.64.0.20/32"],
        "portRanges": [{ "low": 23000, "high": 23000 }]
      }
    },
    {
      "name": "test_os_posture_host_cfg",
